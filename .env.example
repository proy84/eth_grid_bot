# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Bybit API credentials. For USE_TESTNET=true these must be Demo Trading
# keys (https://bybit-exchange.github.io/docs/v5/demo); for USE_TESTNET=false
# they must be real mainnet keys with trading permission enabled.
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true  -> private/trading calls go to Bybit's Demo Trading host (paper money, safe default).
# false -> private/trading calls go to Bybit's live production host (REAL FUNDS).
USE_TESTNET=true

# CCXT/Bybit V5 perpetual symbol, e.g. ETH/USDT:USDT or BTC/USDT:USDT.
SYMBOL=ETH/USDT:USDT

# Geometric grid step, in percent (0.5 = 0.5% between levels).
GRID_STEP_PERCENT=0.5
